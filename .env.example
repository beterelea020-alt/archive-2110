# PostgreSQL (local Docker by default; for Supabase, replace DATABASE_URL with the URI from Connect → Transaction pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archive2110
# false for local Docker; set true for Supabase hosted PostgreSQL
DATABASE_SSL=false
# Optional: production defaults to 1 connection for Vercel/serverless; local defaults to 10
DB_POOL_MAX=

# Use a long random secret (at least 32 characters) in production
AUTH_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# The first administrator is created during npm run db:setup only when both values exist.
# Set a unique email and a strong password before setup; do not deploy example credentials.
ADMIN_EMAIL=beter02@gmail.com
ADMIN_PASSWORD=01224886344

# Game-day defaults; administration can change the date and round times after setup.
GAME_DATE=2026-11-01
